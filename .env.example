# Copiar a .env y completar. Generar secretos con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# Firma las cookies de sesión de Flask
FLASK_SECRET_KEY=
FLASK_DEBUG=0

# Secreto compartido Flask <-> PHP: PHP rechaza toda petición que no lo traiga
INTERNAL_TOKEN=

# PHP visto desde Flask (contenedor) y Flask visto desde PHP (host)
PHP_URL=http://172.19.0.1:8000
FLASK_URL=http://localhost:5001

# HTTPS (nginx). Se publica en estos puertos del host; en el hosting: 443 y 80.
# En esta PC el 80 ya lo usa un Apache del sistema, por eso 8081.
HTTPS_PORT=443
HTTP_PORT=80
# 1 = la cookie de sesión solo viaja por HTTPS
COOKIE_SEGURA=1
# Sesión: minutos sin actividad y horas máximas (un turno) antes de cerrar
SESION_INACTIVIDAD_MIN=60
SESION_MAXIMA_HORAS=12

# Retención de datos biométricos (Ley 29733), en días (ver limpiar_biometria.py)
RETENCION_NO_RECONOCIDOS_DIAS=90
RETENCION_BAJA_DIAS=30

# Zona horaria de PHP (debe coincidir con la de MySQL: -05:00)
APP_TIMEZONE=America/Lima

# MySQL se publica solo en 127.0.0.1 (ver docker-compose.yml)
DB_HOST=127.0.0.1
DB_NAME=control_acceso
# Usuario con permisos mínimos (SELECT/INSERT/UPDATE/DELETE sobre control_acceso):
#   CREATE USER 'app_acceso'@'%' IDENTIFIED BY '...';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON control_acceso.* TO 'app_acceso'@'%';
DB_USER=app_acceso
DB_PASSWORD=

# Solo para administrar MySQL (phpMyAdmin, migraciones, respaldos). La app NO lo usa.
MYSQL_ROOT_PASSWORD=
